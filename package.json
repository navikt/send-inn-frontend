{
  "name": "send-inn-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack -p 3100",
    "dev:mock": "cross-env-shell NODE_ENV=test next dev --webpack -p 3100",
    "build": "next build --webpack",
    "build:mock": "cross-env-shell NODE_ENV=test next build --webpack",
    "start": "next start -p 3100",
    "start:with:test": "cross-env-shell NODE_ENV=test next start -p 3100",
    "test:redirects": "node --test tests/legacy-redirects.test.js",
    "lint": "eslint .",
    "prepare": "husky",
    "cypress": "npx cypress open",
    "cypress:headless": "npx cypress run",
    "prettier": "prettier --write ."
  },
  "dependencies": {
    "@navikt/aksel-icons": "^8.19.1",
    "@navikt/ds-css": "^8.19.1",
    "@navikt/ds-react": "^8.19.1",
    "@navikt/nav-dekoratoren-moduler": "^4.5.1",
    "axios": "^1.20.0",
    "html-react-parser": "^6.1.8",
    "i18next": "^26.4.4",
    "next": "^16.4.1",
    "prom-client": "^15.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^17.0.16",
    "sanitize-html": "^2.18.1",
    "styled-components": "^6.5.3",
    "swr": "^2.5.1",
    "use-debounce": "^10.1.1",
    "uuid": "^14.0.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/cypress": "^10.1.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "cross-env": "^10.1.0",
    "cypress": "^15.21.1",
    "cypress-axe": "^1.7.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^6.4.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "msw": "^3.0.3",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,mdx}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24.22.1 <25"
  }
}

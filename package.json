{
  "name": "send-inn-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack -p 3100",
    "dev:mock": "cross-env-shell NODE_ENV=test next dev --webpack -p 3100",
    "build": "next build --webpack",
    "build:mock": "cross-env-shell NODE_ENV=test next build --webpack",
    "start": "next start -p 3100",
    "start:with:test": "cross-env-shell NODE_ENV=test next start -p 3100",
    "lint": "eslint .",
    "prepare": "husky",
    "cypress": "npx cypress open",
    "cypress:headless": "npx cypress run",
    "prettier": "prettier --write ."
  },
  "dependencies": {
    "@navikt/aksel-icons": "^8.16.2",
    "@navikt/ds-css": "^8.16.2",
    "@navikt/ds-react": "^8.16.2",
    "@navikt/nav-dekoratoren-moduler": "^4.3.0",
    "axios": "^1.20.0",
    "html-react-parser": "^6.1.7",
    "i18next": "^26.4.2",
    "next": "^16.3.4",
    "prom-client": "^15.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-i18next": "^17.0.13",
    "sanitize-html": "^2.17.7",
    "styled-components": "^6.5.3",
    "swr": "^2.5.1",
    "use-debounce": "^10.1.1",
    "uuid": "^14.0.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/cypress": "^10.1.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "cross-env": "^10.1.0",
    "cypress": "^16.0.0",
    "cypress-axe": "^1.7.0",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^7.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,mdx}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24"
  }
}

{
  "name": "send-inn-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack -p 3100",
    "dev:mock": "cross-env-shell NODE_ENV=test next dev --webpack -p 3100",
    "build": "next build --webpack",
    "build:mock": "cross-env-shell NODE_ENV=test next build --webpack",
    "start": "next start -p 3100",
    "start:with:test": "cross-env-shell NODE_ENV=test next start -p 3100",
    "lint": "eslint .",
    "prepare": "husky",
    "cypress": "npx cypress open",
    "cypress:headless": "npx cypress run",
    "prettier": "prettier --write ."
  },
  "dependencies": {
    "@navikt/aksel-icons": "^8.16.1",
    "@navikt/ds-css": "^8.16.1",
    "@navikt/ds-react": "^8.16.1",
    "@navikt/nav-dekoratoren-moduler": "^3.4.0",
    "@sentry/nextjs": "^10.70.0",
    "axios": "^1.19.0",
    "html-react-parser": "^6.1.7",
    "i18next": "^26.3.6",
    "next": "^16.3.1",
    "prom-client": "^15.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-i18next": "^17.0.11",
    "sanitize-html": "^2.17.7",
    "styled-components": "^6.5.3",
    "swr": "^2.5.1",
    "use-debounce": "^10.1.1",
    "uuid": "^14.0.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@sentry/cli": "^3.6.2",
    "@testing-library/cypress": "^10.1.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.67.0",
    "cross-env": "^10.1.0",
    "cypress": "^15.21.1",
    "cypress-axe": "^1.7.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^5.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,mdx}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24"
  }
}

{
  "name": "send-inn-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack -p 3100",
    "dev:mock": "cross-env-shell NODE_ENV=test next dev --webpack -p 3100",
    "build": "next build --webpack",
    "build:mock": "cross-env-shell NODE_ENV=test next build --webpack",
    "start": "next start -p 3100",
    "start:with:test": "cross-env-shell NODE_ENV=test next start -p 3100",
    "test:http": "node --test tests/*.test.js",
    "lint": "eslint .",
    "prepare": "husky",
    "cypress": "npx cypress open",
    "cypress:headless": "npx cypress run",
    "prettier": "prettier --write ."
  },
  "dependencies": {
    "@navikt/aksel-icons": "^8.23.0",
    "@navikt/ds-css": "^8.23.0",
    "@navikt/ds-react": "^8.23.0",
    "@navikt/nav-dekoratoren-moduler": "^4.6.0",
    "axios": "^1.21.1",
    "html-react-parser": "^6.1.10",
    "i18next": "^27.1.3",
    "next": "^16.4.6",
    "prom-client": "^15.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^18.0.2",
    "sanitize-html": "^2.18.2",
    "styled-components": "^6.6.0",
    "swr": "^2.5.1",
    "use-debounce": "^10.1.1",
    "uuid": "^14.0.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/cypress": "^10.1.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "cross-env": "^10.1.0",
    "cypress": "^15.21.2",
    "cypress-axe": "^1.7.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^6.4.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "msw": "^3.0.6",
    "prettier": "^3.10.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,mdx}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=26.13.1 <27"
  }
}
